<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    tools:context=".ui.detail.DetailActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="116dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/drawer_close"
                    android:padding="8dp"
                    android:src="@drawable/ic_back_round"
                    app:tint="@color/brand_text" />

                <TextView
                    android:id="@+id/pageTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/inter"
                    android:text="@string/detail_title"
                    android:textColor="@color/brand_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/bookmarkButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/detail_save"
                        android:padding="8dp"
                        android:src="@drawable/ic_bookmark_outline"
                        android:visibility="gone"
                        app:tint="@color/brand_text" />

                    <ImageButton
                        android:id="@+id/moreButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/detail_more"
                        android:padding="8dp"
                        android:src="@drawable/ic_more_vertical"
                        app:tint="@color/brand_text" />
                </LinearLayout>
            </RelativeLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <FrameLayout
                    android:id="@+id/videoPreviewContainer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_detail_media_placeholder"
                    android:clipToOutline="true"
                    app:layout_constraintDimensionRatio="H,10:11"
                    app:layout_constraintEnd_toStartOf="@id/headerContentContainer"
                    app:layout_constraintHorizontal_weight="0.88"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/thumbnailImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/InstafactShapeAppearanceThumbHero"
                        tools:src="@drawable/ic_launcher" />

                    <LinearLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_light_icon_circle"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/platformBadgeImageView"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_instagram" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/videoDurationTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_media_duration"
                        android:fontFamily="@font/inter"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="0:24"
                        tools:visibility="visible" />

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_detail_play_button">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/detail_play"
                            android:src="@drawable/ic_play_filled"
                            app:tint="@android:color/white" />
                    </FrameLayout>
                </FrameLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/headerContentContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1.0"
                    app:layout_constraintStart_toEndOf="@id/videoPreviewContainer"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/statusTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter"
                        android:lineSpacingMultiplier="1.0"
                        android:maxLines="3"
                        android:textColor="@color/brand_text"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Drinking hot water burns fat and helps in weight loss" />

                    <TextView
                        android:id="@+id/videoMetaTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:textColor="@color/brand_muted"
                        android:textSize="10sp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/statusTextView"
                        tools:text="Checked 3 days ago"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/linkRowContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/statusTextView">

                        <ImageView
                            android:id="@+id/platformImageView"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_instagram" />

                        <TextView
                            android:id="@+id/videoUrlTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter"
                            android:maxLines="1"
                            android:textColor="@color/brand_muted"
                            android:textSize="10sp"
                            tools:text="instagram.com/reel/C8abc..." />

                        <ImageButton
                            android:id="@+id/copyLinkButton"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/detail_copy_link"
                            android:padding="0dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_copy_outline"
                            app:tint="@color/brand_muted" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shareReelButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:text="@string/detail_share_reel"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:cornerRadius="13dp"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:iconSize="12dp"
                        app:iconTint="@color/brand_primary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/linkRowContainer"
                        app:strokeColor="@color/brand_primary"
                        app:strokeWidth="1dp" />

                    <TextView
                        android:id="@+id/sourcesLabelTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/detail_tags"
                        android:textColor="@color/brand_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/shareReelButton" />

                    <HorizontalScrollView
                        android:id="@+id/tagsScrollView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fadingEdgeLength="20dp"
                        android:fillViewport="false"
                        android:overScrollMode="never"
                        android:requiresFadingEdge="horizontal"
                        android:scrollbars="none"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/sourcesLabelTextView">

                        <LinearLayout
                            android:id="@+id/tagsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:letterSpacing="0.02"
                            android:text="@string/detail_result_header"
                            android:textColor="@color/brand_primary"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/verdictIconImageView"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_verdict_true_outline" />

                            <TextView
                                android:id="@+id/verdictTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/inter"
                                android:textColor="@color/brand_status_true"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="Mostly True" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/resultSummaryTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter"
                            android:lineSpacingExtra="1dp"
                            android:textColor="@color/brand_text"
                            android:textSize="10.5sp"
                            tools:text="This reel is mostly true, but some facts are exaggerated." />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="106dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="74dp">

                            <com.instafact.app.ui.detail.ConfidenceGaugeView
                                android:id="@+id/confidenceGaugeView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/confidenceTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal|center_vertical"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/inter"
                                android:textColor="@color/brand_status_true"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="75%" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="@string/detail_confidence_score"
                                android:textColor="@color/brand_text"
                                android:textSize="9sp" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_help_outline"
                                app:tint="@color/brand_muted" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
              Shown instead of the result card while the check is still running, so a query
              with no verdict yet never reads as the "Unverified" verdict.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/inProgressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp">

                        <ProgressBar
                            android:id="@+id/inProgressSpinner"
                            style="?android:attr/progressBarStyle"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/brand_primary" />

                        <ImageView
                            android:id="@+id/inProgressIconImageView"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_clock_outline"
                            app:tint="@color/brand_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/inProgressTitleTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="@string/detail_in_progress_title"
                            android:textColor="@color/brand_ink"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/inProgressBodyTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/detail_in_progress_body"
                            android:textColor="@color/brand_muted"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tabSummaryContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/tabSummaryIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_document_outline"
                            app:tint="@color/brand_primary" />

                        <TextView
                            android:id="@+id/tabSummaryTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter"
                            android:text="@string/detail_tab_summary"
                            android:textColor="@color/brand_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/tabSummaryIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/brand_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabDetailsContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/tabDetailsIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_list_outline"
                            app:tint="@color/brand_muted" />

                        <TextView
                            android:id="@+id/tabDetailsTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter"
                            android:text="@string/detail_tab_details"
                            android:textColor="@color/brand_muted"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/tabDetailsIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="12dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabReferencesContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/tabReferencesIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_link"
                            app:tint="@color/brand_muted" />

                        <TextView
                            android:id="@+id/tabReferencesTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter"
                            android:text="@string/detail_tab_references"
                            android:textColor="@color/brand_muted"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/tabReferencesIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="12dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/brand_divider" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summarySectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_light_icon_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_sparkle"
                                app:tint="@color/brand_primary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/inter"
                            android:text="@string/detail_tab_summary"
                            android:textColor="@color/brand_text"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/summaryTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/brand_text"
                        android:textSize="12.5sp"
                        tools:text="Drinking hot water may support weight loss by boosting metabolism and promoting satiety. However, it does not directly burn fat." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="22dp"
                        android:background="@color/brand_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_light_icon_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_search"
                                app:tint="@color/brand_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/explanationTitleTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/inter"
                            android:text="@string/detail_detailed_explanation"
                            android:textColor="@color/brand_text"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/explanationTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/brand_text"
                        android:textSize="12.5sp"
                        tools:text="While hot water can aid digestion, improve circulation, and help you feel fuller, there is no strong scientific evidence that it directly burns fat." />

                    <TextView
                        android:id="@+id/readMoreTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:drawableEnd="@drawable/ic_chevron_down_small"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/inter"
                        android:gravity="center_vertical"
                        android:text="@string/detail_read_more"
                        android:textColor="@color/brand_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/referencesSectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_light_icon_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_book_outline"
                                app:tint="@color/brand_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/referencesTitleTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter"
                            android:text="@string/detail_references_title"
                            android:textColor="@color/brand_text"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                        android:id="@+id/viewAllReferencesTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/detail_view_all"
                        android:textColor="@color/brand_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/referencesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/emptyReferencesTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/detail_references_empty"
                        android:textColor="@color/brand_muted"
                        android:textSize="12.5sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/feedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_feedback_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/detail_feedback_title"
                        android:textColor="@color/brand_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/detail_feedback_subtitle"
                        android:textColor="@color/brand_muted"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/thumbsUpButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter"
                    android:minWidth="56dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="0"
                    android:textAllCaps="false"
                    android:textSize="12.5sp"
                    android:textColor="@color/brand_text"
                    app:backgroundTint="@color/brand_surface"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_helpful_outline"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/brand_text"
                    app:strokeColor="@color/brand_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/thumbsDownButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter"
                    android:minWidth="56dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="0"
                    android:textAllCaps="false"
                    android:textSize="12.5sp"
                    android:textColor="@color/brand_text"
                    app:backgroundTint="@color/brand_surface"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_not_helpful_outline"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/brand_text"
                    app:strokeColor="@color/brand_border" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/askAiButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_detail_cta"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chat_send"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:text="@string/detail_ai_button"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter"
            android:text="@string/detail_ai_subtitle"
            android:textColor="@android:color/white"
            android:textSize="10.5sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/detailProgressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detailErrorTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:textColor="@color/error"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="Unable to load the fact-check result." />

</FrameLayout>
