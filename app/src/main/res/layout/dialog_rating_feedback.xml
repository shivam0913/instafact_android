<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="@string/rating_feedback_title"
            android:textColor="@color/brand_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter"
            android:text="@string/rating_feedback_subtitle"
            android:textColor="@color/brand_muted"
            android:textSize="13sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/reasonChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:chipSpacingVertical="2dp"
            app:selectionRequired="false"
            app:singleSelection="false" />

        <EditText
            android:id="@+id/feedbackCommentEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_login_input"
            android:fontFamily="@font/inter"
            android:gravity="top|start"
            android:hint="@string/rating_feedback_comment_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="@color/brand_text"
            android:textColorHint="@color/brand_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/feedbackCancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/inter"
                android:padding="12dp"
                android:text="@string/rating_not_now"
                android:textColor="@color/brand_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/feedbackSendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/inter"
                android:padding="12dp"
                android:text="@string/rating_feedback_send"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
