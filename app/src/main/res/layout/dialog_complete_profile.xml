<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- Branded mark, the same tile the walkthrough opens with, so the dialog reads
             as part of the app rather than a system form. -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_walk_logo_tile">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_instafact_logo" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/profile_completion_title"
            android:textColor="@color/brand_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/profile_completion_message"
            android:textColor="@color/brand_muted"
            android:textSize="13sp" />

        <!-- Name -->
        <TextView
            style="@style/Instafact.ProfileFieldLabel"
            android:layout_marginTop="24dp"
            android:text="@string/profile_name" />

        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_login_input"
            android:fontFamily="@font/inter"
            android:hint="@string/profile_name_hint"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="60"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:textColor="@color/brand_text"
            android:textColorHint="@color/brand_muted"
            android:textSize="15sp" />

        <!-- Gender: chips rather than a dropdown. Three short options are faster to tap
             than to open, scroll and select, and they match the filter chips on Home. -->
        <TextView
            style="@style/Instafact.ProfileFieldLabel"
            android:layout_marginTop="18dp"
            android:text="@string/profile_gender" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/genderChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingVertical="2dp"
            app:selectionRequired="false"
            app:singleSelection="true" />

        <TextView
            style="@style/Instafact.ProfileFieldLabel"
            android:layout_marginTop="18dp"
            android:text="@string/profile_age_group" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ageGroupChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingVertical="2dp"
            app:selectionRequired="false"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/profileErrorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter"
            android:textColor="@color/brand_status_false"
            android:textSize="12.5sp"
            android:visibility="gone"
            tools:text="Please tell us your name."
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/profileSaveButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_auth_cta"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/profile_complete_now"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileSkipButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/profile_complete_skip"
            android:textColor="@color/brand_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
