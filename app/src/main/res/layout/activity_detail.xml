<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    tools:context=".ui.detail.DetailActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/heroContainer"
                android:layout_width="match_parent"
                android:layout_height="312dp"
                android:background="@drawable/bg_detail_hero">

                <FrameLayout
                    android:id="@+id/videoPreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="70dp"
                    android:layout_marginBottom="34dp"
                    android:background="@drawable/bg_media_placeholder">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/thumbnailImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/InstafactShapeAppearanceThumbHero"
                        tools:src="@drawable/ic_launcher" />

                    <LinearLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_light_icon_circle"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/detail_play"
                            android:src="@drawable/ic_play_filled"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/topBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp">

                    <ImageButton
                        android:id="@+id/backButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/drawer_close"
                        android:src="@drawable/ic_back_round" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/shareButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/share_result"
                        android:src="@drawable/ic_share"
                        app:tint="@color/white" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/contentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-26dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/statusTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_text"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        tools:text="Lemon water melts fat instantly in the morning?" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/platformImageView"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_instagram" />

                        <TextView
                            android:id="@+id/platformNameTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/brand_muted"
                            android:textSize="12sp"
                            tools:text="Instagram Reel" />

                        <TextView
                            android:id="@+id/videoMetaTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/brand_muted"
                            android:textSize="12sp"
                            tools:text="• Shared 3 days ago" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/videoUrlTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/brand_primary"
                            android:textSize="13sp"
                            tools:text="https://www.instagram.com/reel/example" />

                        <ImageButton
                            android:id="@+id/linkShareButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/share_result"
                            android:src="@drawable/ic_share"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/verdictBannerCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp">

                            <ImageView
                                android:id="@+id/verdictIconImageView"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_link"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/verdictTextView"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:textColor="@color/white"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="Misleading" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/confidence_label"
                                    android:textColor="#FDFDFD"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/confidenceTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/white"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    tools:text="68%" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/verifiedChipTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_primary"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:text="@string/ai_verified"
                            android:textColor="@color/brand_text"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/checkedSourcesChipTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_primary"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:text="@string/checked_sources_count"
                            android:textColor="@color/brand_text"
                            android:textSize="12sp"
                            tools:text="Checked 3 sources" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/explanationTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/why_this_is_misleading"
                        android:textColor="@color/brand_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/explanationTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/brand_text"
                        android:textSize="14sp"
                        tools:text="• Lemon water alone does not melt fat.\n\n• Weight loss depends on overall diet and exercise." />

                    <TextView
                        android:id="@+id/sourcesLabelTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/detail_sources"
                        android:textColor="@color/brand_muted"
                        android:textSize="12sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/tagsChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/askAiButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/detail_ai_button"
                        app:backgroundTint="@color/brand_primary"
                        app:icon="@drawable/ic_sparkle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/detail_feedback_caption"
                        android:textColor="@color/brand_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/thumbsUpButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/feedback_up"
                            app:icon="@drawable/ic_thumb_up"
                            app:iconTint="@color/brand_muted" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/thumbsDownButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/feedback_down"
                            app:icon="@drawable/ic_thumb_down"
                            app:iconTint="@color/brand_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/detailProgressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detailErrorTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:textColor="@color/error"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="Unable to load the fact-check result." />

</FrameLayout>
