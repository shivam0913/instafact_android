<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent dark panel so the caption reads over the dimmed screen without
     becoming a solid block that hides the app behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F21A1A2E" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
