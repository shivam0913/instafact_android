<?xml version="1.0" encoding="utf-8"?>
<!-- Page 2: reel on a phone, arrow to the InstaFact tile, then the result card. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/phoneImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:layout_marginStart="24dp"
        android:src="@drawable/walk2_phone"
        app:layout_constraintDimensionRatio="H,312:652"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.44" />

    <ImageView
        android:id="@+id/flowArrowImageView"
        android:layout_width="58dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="34dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_curved_arrow"
        app:layout_constraintStart_toEndOf="@id/phoneImageView"
        app:layout_constraintTop_toTopOf="@id/phoneImageView" />

    <FrameLayout
        android:id="@+id/logoTile"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_walk_logo_tile"
        android:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_instafact_logo" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="@color/brand_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:contentPadding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.74"
        app:layout_constraintHorizontal_bias="1">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_verdict_check_filled" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/walk_result_label"
                    android:textColor="@color/brand_ink"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/walk_result_verdict"
                    android:textColor="#20A144"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="2dp"
            android:text="@string/walk_result_body"
            android:textColor="@color/brand_muted"
            android:textSize="11.5sp"
            tools:ignore="SmallSp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
