<?xml version="1.0" encoding="utf-8"?>
<!--
  Page 1: the photo dissolves into the page (no hard card edge) and the three claim reels
  sit on tilted white-bordered cards with a drop shadow, as in the mockup.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.instafact.app.ui.walkthrough.FeatheredImageView
        android:id="@+id/personImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/walk1_person"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.92"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.66"
        app:featherRight="false" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reelOne"
        style="@style/WalkReelCard"
        android:layout_marginStart="24dp"
        android:rotation="-3.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/walk_reel_1"
            android:src="@drawable/walk1_reel1" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reelTwo"
        style="@style/WalkReelCard"
        android:layout_marginStart="50dp"
        android:layout_marginTop="-10dp"
        android:rotation="2.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reelOne">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/walk_reel_2"
            android:src="@drawable/walk1_reel2" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reelThree"
        style="@style/WalkReelCard"
        android:layout_marginStart="24dp"
        android:layout_marginTop="-10dp"
        android:rotation="-2.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reelTwo"
        tools:ignore="NotSibling">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/walk_reel_3"
            android:src="@drawable/walk1_reel3" />
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
