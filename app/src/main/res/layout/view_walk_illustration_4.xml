<?xml version="1.0" encoding="utf-8"?>
<!--
  Page 4: family photo with two cards floating over its lower edge, as in the mockup.
  Everything is anchored to the parent bottom so nothing is clipped by the nav row.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <com.instafact.app.ui.walkthrough.FeatheredImageView
        android:id="@+id/familyImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/walk4_family"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.72"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:featherLeft="false"
        app:featherRight="false" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sharedReelCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:rotation="-3"
        app:cardBackgroundColor="@color/brand_surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="12dp"
        app:contentPadding="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.32">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/walk_shared_reel_title"
            android:src="@drawable/walk4_food" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/checkedCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_walk_card"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="@id/sharedReelCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"
        app:layout_constraintTop_toTopOf="@id/sharedReelCard"
        app:layout_constraintWidth_percent="0.70">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_verdict_check_filled" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/checkedTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="@string/walk_shared_title"
                android:textColor="@color/brand_ink"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="Checked with InstaFact" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="1dp"
                android:text="@string/walk_shared_body"
                android:textColor="@color/brand_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
