<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="@string/country_picker_title"
        android:textColor="@color/brand_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/countrySearchEditText"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:autofillHints="addressCountry"
        android:background="@drawable/bg_login_input"
        android:fontFamily="@font/inter"
        android:hint="@string/country_picker_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/brand_text"
        android:textColorHint="@color/brand_muted"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/countryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        tools:listitem="@layout/item_country" />

    <TextView
        android:id="@+id/countryEmptyTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/country_picker_empty"
        android:textColor="@color/brand_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
